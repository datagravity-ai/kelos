{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "consoleServer": {
      "type": "object",
      "properties": {
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "staticToken",
                "oidc"
              ]
            },
            "oidc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "issuerURL": {
                  "type": "string",
                  "minLength": 1
                },
                "clientID": {
                  "type": "string",
                  "minLength": 1
                },
                "redirectURL": {
                  "type": "string",
                  "minLength": 1
                },
                "secretName": {
                  "type": "string",
                  "minLength": 1
                },
                "usernamePrefix": {
                  "type": "string",
                  "minLength": 1
                },
                "groupsPrefix": {
                  "type": "string",
                  "minLength": 1
                },
                "image": {
                  "type": "string",
                  "minLength": 1
                },
                "clientSecretKey": {
                  "type": "string",
                  "minLength": 1
                },
                "cookieSecretKey": {
                  "type": "string",
                  "minLength": 1
                },
                "groupsClaim": {
                  "type": "string",
                  "minLength": 1
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                },
                "reverseProxy": {
                  "type": "boolean"
                },
                "trustedProxyIPs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
